<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  id="Defs_prince2" targetNamespace="http://fastplan.local/bpmn">
  <bpmn:process id="Prince2Stage" name="PRINCE2 Stage lite" isExecutable="true">
    <bpmn:startEvent id="Start_1" name="Stage start">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Authorize" name="Authorize work package">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Execute" name="Execute / control">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Review" name="End stage review (go/no-go)">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_1" name="Stage complete">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start_1" targetRef="Task_Authorize"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Task_Authorize" targetRef="Task_Execute"/>
    <bpmn:sequenceFlow id="f3" sourceRef="Task_Execute" targetRef="Task_Review"/>
    <bpmn:sequenceFlow id="f4" sourceRef="Task_Review" targetRef="End_1"/>
  </bpmn:process>
</bpmn:definitions>
