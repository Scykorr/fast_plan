<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  id="Defs_waterfall_gate" targetNamespace="http://fastplan.local/bpmn">
  <bpmn:process id="WaterfallPhaseGate" name="Waterfall phase gate" isExecutable="true">
    <bpmn:startEvent id="Start_1" name="Gate opened">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_Submit" name="Submit phase package">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Review" name="Review checklist">
      <bpmn:incoming>f2</bpmn:incoming>
      <bpmn:outgoing>f3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Decide" name="Go / No-Go decision">
      <bpmn:incoming>f3</bpmn:incoming>
      <bpmn:outgoing>f4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_1" name="Gate closed">
      <bpmn:incoming>f4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="Start_1" targetRef="Task_Submit"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Task_Submit" targetRef="Task_Review"/>
    <bpmn:sequenceFlow id="f3" sourceRef="Task_Review" targetRef="Task_Decide"/>
    <bpmn:sequenceFlow id="f4" sourceRef="Task_Decide" targetRef="End_1"/>
  </bpmn:process>
</bpmn:definitions>
